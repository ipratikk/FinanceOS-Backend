DATABASE_URL=postgresql://financeOS:financeOS@localhost:5432/financeOS
PYTHON_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Shared between
# node_api and python_service for Postgres column encryption (AES-256-GCM).
DATABASE_ENCRYPTION_KEY=
# 32 random bytes, base64-encoded — the private half of the P-256 keypair whose
# public half is embedded in the Swift client for password-protected PDF import.
# Generate via node_api/scripts/generate-import-password-keypair.js.
IMPORT_PASSWORD_PRIVATE_KEY=
